<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    tools：批改（题目编程题）与代码补全。在 core 的基础上多了 Features 与 Workspaces，体积更大，
    只在首次补全或批改时才加载。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Runner</AssemblyName>
    <RootNamespace>Runner</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <!-- 运行器不裁剪：裁剪会删掉用户程序需要的框架成员（实测 6/6 程序报 Method not found） -->
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RunnerCore.cs" Link="RunnerCore.cs" />
    <Compile Include="Completion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
  </ItemGroup>

</Project>
