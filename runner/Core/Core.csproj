<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    core：交互式运行（编译、运行、输入输出）。只引用 Roslyn 编译器本体，体积较小。
    浏览器端加载在 Web Worker 中，由 runner/main.js 启动。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Runner</AssemblyName>
    <RootNamespace>Runner</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <!-- 运行器不裁剪：裁剪会删掉用户程序需要的框架成员（实测 6/6 程序报 Method not found） -->
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RunnerCore.cs" Link="RunnerCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
