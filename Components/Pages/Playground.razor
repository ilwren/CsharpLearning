@page "/playground"

<PageTitle>在线编辑器 · C# 自学教程</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">在线编辑器</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    在这里写任意 C# 代码（支持语法高亮和代码补全，按 <kbd>Ctrl</kbd>+<kbd>Space</kbd> 手动触发补全）。点“运行”即可编译并查看输出。
</MudText>

<RunPanel Title="自由练习" Height="520px" InitialCode="@_starter" />

@code {
    private const string _starter = """
        using System;

        // 试着改一改这段代码，然后点击“运行”。
        var names = new[] { "LogLens", "C#", "Blazor" };
        foreach (var name in names)
        {
            Console.WriteLine($"Hello, {name}! ({name.Length} 个字符)");
        }
        """;
}
