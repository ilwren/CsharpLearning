@page "/"
@inject ContentStore Content

<PageTitle>C# 自学教程</PageTitle>

<MudText Typo="Typo.h3" Class="mb-2">C# 自学教程</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    从“程序是什么”开始，一章一章学会 C#，最后用它做出一个真正的日志分析工具 LogLens。每一章都有可以直接运行的示例和练习题，练习题会真的编译你的代码并比对输出。
</MudText>

<MudAlert Severity="Severity.Info" Class="mb-6">
    想先动手？<MudLink Href="/playground">打开在线编辑器</MudLink>，写一段代码，点“运行”。
</MudAlert>

@foreach (var group in Content.Ordered.GroupBy(c => c.Part))
{
    <MudText Typo="Typo.h5" Class="mt-6 mb-3">@group.Key</MudText>
    <MudGrid Spacing="2">
        @foreach (var c in group)
        {
            <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex">
                <MudCard Elevation="1" Class="lt-card lt-home-card flex-grow-1">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1"><MudLink Href="@c.Url" Underline="Underline.None">@c.Title</MudLink></MudText>
                        @if (Content.GetQuiz(c.Key) is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">有练习题</MudChip>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
